{
  "type": "module",
  "name": "my-collection-search",
  "version": "0.3.9",
  "private": true,
  "engines": {
    "npm": "12.0.1"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "core-js",
    "esbuild",
    "fsevents",
    "sharp",
    "unrs-resolver"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:db": "RUN_DB_TESTS=1 vitest run",
    "test:fingerprints": "RUN_DB_TESTS=1 vitest run src/server/repositories/__tests__/fingerprintRepository.integration.test.ts",
    "test:play-detections": "RUN_DB_TESTS=1 vitest run src/server/repositories/__tests__/playDetectionRepository.integration.test.ts",
    "test:ingest": "RUN_DB_TESTS=1 vitest run src/server/repositories/__tests__/audioIngestRepository.integration.test.ts",
    "test:set-derivations": "RUN_DB_TESTS=1 vitest run src/server/repositories/__tests__/setDerivationRepository.integration.test.ts",
    "test:debug-reads": "RUN_DB_TESTS=1 vitest run src/server/repositories/__tests__/debugReads.integration.test.ts",
    "test:embedding-versions": "RUN_DB_TESTS=1 vitest run src/server/repositories/__tests__/embeddingVersions.integration.test.ts src/server/repositories/__tests__/contextRetrieval.integration.test.ts src/server/services/__tests__/semanticTrackSearch.integration.test.ts src/app/api/tracks/search/__tests__/route.integration.test.ts src/server/repositories/__tests__/recommendationScope.integration.test.ts",
    "test:spin-sessions": "RUN_DB_TESTS=1 vitest run --no-file-parallelism src/server/repositories/__tests__/spinSessionRepository.integration.test.ts src/server/services/__tests__/spinLoggingService.integration.test.ts src/server/services/__tests__/playlistSpinService.integration.test.ts",
    "test:record-care": "RUN_DB_TESTS=1 vitest run src/server/services/__tests__/recordCareService.integration.test.ts",
    "test:redis": "RUN_REDIS_TESTS=1 vitest run --no-file-parallelism src/server/services/__tests__/redisJobService.integration.test.ts src/server/services/__tests__/ingestMetricsService.integration.test.ts src/server/services/__tests__/embeddingQueueService.integration.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc6 --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "node-pg-migrate",
    "psql": "docker compose exec db psql -U djplaylist -d djplaylist",
    "worker": "tsx src/workers/index.ts",
    "worker:dev": "nodemon --watch src --ext ts,js --exec 'npm run worker'",
    "screenshots:readme": "tsx scripts/readme-screenshots.ts",
    "screenshots:mobile": "tsx scripts/mobile-screenshots.ts",
    "backfill-essentia": "tsx src/scripts/backfill-essentia.ts",
    "backfill-key-confidence": "tsx src/scripts/backfill-key-confidence.ts",
    "backfill-bpm-confidence": "tsx src/scripts/backfill-bpm-confidence.ts",
    "openapi:check": "node --import tsx/esm scripts/check-openapi.ts",
    "openapi:generate-spec": "node --import tsx/esm scripts/generate-openapi-json.ts ../openapi-generated.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o public/storybook && node scripts/check-storybook.mjs",
    "test:storybook": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include=scripts/check-storybook.mjs --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/storybook.lcov scripts/check-storybook.test.mjs scripts/storybook-deployment.test.mjs"
  },
  "dependencies": {
    "@groovenet/contracts": "file:../packages/groovenet-contracts",
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@sentry/nextjs": "^11.6.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-virtual": "3.14.15",
    "cmdk": "^1.1.1",
    "essentia.js": "^0.1.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "mqtt": "^5.16.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "openai": "^7.30.1",
    "pg": "^8.23.1",
    "posthog-js": "^1.438.3",
    "posthog-node": "^5.55.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.5",
    "uuid": "^14.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.64.0",
    "@storybook/nextjs-vite": "^10.6.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-storybook": "^10.6.1",
    "jsdom": "30.1.2",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14",
    "storybook": "^10.6.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  }
}
