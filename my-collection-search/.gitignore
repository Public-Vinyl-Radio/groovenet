# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example and .env.tpl live at repo root now
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cookie files - keep these local and out of repo
/cookies/
*.cookies.txt

# Album cover uploads
/public/uploads/album-covers/*
!/public/uploads/album-covers/.gitkeep

# Raw Essentia analysis files
/essentia-data/*
!/essentia-data/.gitkeep

# Sentry Config File
.env.sentry-build-plugin

# Mobile screenshot tool output
/mobile-screenshots/

*storybook.log
storybook-static
# Static Storybook build served same-origin by the app (see build-storybook)
/public/storybook
