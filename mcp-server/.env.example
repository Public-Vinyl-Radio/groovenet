# API Configuration
# For local development:
# API_BASE=http://localhost:3000/api
# For production:
# API_BASE=https://your-production-server.com/api
API_BASE=http://localhost:3000/api
# Optional: PEM CA bundle for an internal CA (e.g. Caddy local root.crt); TLS verification stays on
# GROOVENET_CA_CERT=/path/to/root.crt

# Optional: API Key for production authentication
API_KEY=

# Database (optional - for direct DB queries)
DATABASE_URL=postgresql://djplaylist:djplaylist@localhost:5432/djplaylist
