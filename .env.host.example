# Host-local deploy settings. Copy to .env.host on the deploy host and edit.
# .env.host is untracked, never rendered from 1Password and never touched by a
# deploy, so these choices survive every release. deploy-prod.sh reads it line
# by line (it is never sourced) and passes it to compose as an extra --env-file.
#
# Precedence for COMPOSE_PROFILES: shell > .env.host > .env/.env.tpl > "all".
# `players` is appended automatically when .env.players exists.
COMPOSE_PROFILES=all,lossless

# Optional: locally built lossless wrapper image. deploy-prod.sh refuses to
# start when `lossless` is enabled and this image is missing on the host.
# GAMDL_WRAPPER_IMAGE=wrapper-v2:1.0.0-local-amd64

# Optional local backup disk (#1311): a second restic repository on an attached
# disk, with its own include policy (by default lossless audio only). Mount the
# disk on the host and create the marker file on it first:
#   touch "$LOCAL_BACKUP_PATH/.groovenet-backup-disk"
# Unset means no local target, no mount and nothing on the System page. When set,
# deploy-prod.sh adds docker-compose.local-backup.yml to bind-mount it.
# LOCAL_BACKUP_PATH=/path/where/the/disk/is/mounted
# Password for the local repository, separate from RESTIC_PASSWORD. Keep a copy
# outside this host: without it the disk's snapshots cannot be read.
# LOCAL_BACKUP_RESTIC_PASSWORD=
