---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { cssVars, fontFaceCss, sitePalette } from "../lib/tokens";

interface Props { title: string; description: string; currentPath?: string; }
const { title, description, currentPath } = Astro.props;
const site = "https://groovenet.publicvinylradio.com";
const canonical = new URL(Astro.url.pathname, site).toString();
const socialCard = `${site}/social-card.png`;

// The page is drawn in the app's Mono palette and follows the visitor's mode.
// --night-* is Mono dark in either mode, for the terminal and the dark phone.
const themeCss = `:root{${cssVars(sitePalette.light)}${cssVars(sitePalette.dark, "--night-")}}@media (prefers-color-scheme: dark){:root{${cssVars(sitePalette.dark)}}}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="preload" href="/fonts/Inter-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/Inter-600.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/JetBrainsMono-600.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <style is:inline set:html={`${fontFaceCss}\n${themeCss}`}></style>
    <link rel="icon" href="/favicon.png" type="image/png" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={sitePalette.light["--gn-ground"]} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={sitePalette.dark["--gn-ground"]} media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialCard} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialCard} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip caps" href="#main">Skip to content</a>
    <Header currentPath={currentPath} />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
<style>
  .skip { position: absolute; left: 16px; top: -100px; z-index: 10; background: var(--ink); color: var(--ground); padding: 12px 16px; text-decoration: none; }
  .skip:focus { top: 16px; }
</style>
