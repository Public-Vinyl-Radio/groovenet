---
import Logo from "./Logo.astro";
---
<footer>
  <div class="wrap inner">
    <div class="brand">
      <Logo height={22} />
      <p>An open-source project from <a href="https://publicvinylradio.com">Public Vinyl Radio</a>.</p>
    </div>
    <ul class="links caps">
      <li><a href="/docs">Docs</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="https://github.com/Public-Vinyl-Radio/groovenet">Source ↗</a></li>
      <li class="cat">PVR / GN–001 · MIT</li>
    </ul>
  </div>
</footer>
<style>
  footer { border-top: 2px solid var(--ink); }
  .inner { padding-block: 36px; display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
  .brand { display: flex; flex-direction: column; gap: 10px; }
  .brand p { font-size: 14px; color: var(--muted); }
  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 24px; }
  .links a { text-decoration: none; }
  .cat { color: var(--muted); }
</style>
