---
// One screenshot slot: the image when #912 has supplied it, otherwise a
// labelled placeholder that fills the same box. A slot with a dark image
// swaps to it in dark mode, like the Logo.
import { Image, getImage } from "astro:assets";
import type { Shot } from "../data/screenshots";

interface Props { shot: Shot; note?: string; widths: number[]; sizes: string; }
const { shot, note, widths, sizes } = Astro.props;
const dark = shot.image && shot.imageDark ? await getImage({ src: shot.imageDark, widths, sizes }) : undefined;
---
{shot.image ? (
  dark ? (
    <picture class="pic">
      <source media="(prefers-color-scheme: dark)" srcset={dark.srcSet.attribute} sizes={sizes} />
      <Image class="img" src={shot.image} alt={shot.alt} widths={widths} sizes={sizes} />
    </picture>
  ) : (
    <Image class="img" src={shot.image} alt={shot.alt} widths={widths} sizes={sizes} />
  )
) : (
  <div class="placeholder" role="img" aria-label={`Screenshot to come: ${shot.alt}`}>
    <div class="hatch" aria-hidden="true"></div>
    <div class="text">
      <div class="caps">[{shot.label}]</div>
      {note && <div class="note">{note}</div>}
    </div>
  </div>
)}
<style>
  .pic { display: block; width: 100%; height: 100%; }
  .img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .placeholder { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: var(--surface); text-align: center; }
  .hatch { position: absolute; inset: 0; opacity: 0.07; }
  .text { position: relative; padding: 16px; display: flex; flex-direction: column; gap: 8px; }
  .caps { font-size: 11px; }
  .note { font-family: var(--mono); font-size: 10px; color: var(--muted); }
</style>
