---
import { getCollection } from "astro:content";
import SectionHead from "./SectionHead.astro";

// Columns come from GitHub labels, or the YAML fallback, in order: Now, Next, Later.
const columns = await getCollection("roadmap");
---
<section id="roadmap" class="wrap section" aria-labelledby="roadmap-title">
  <SectionHead tag="Roadmap / 03" aside="follow along on GitHub ↗" asideHref="https://github.com/Public-Vinyl-Radio/groovenet/issues" />
  <h2 id="roadmap-title" class="h2">What’s next on the deck.</h2>
  <div class="cols">
    {columns.map((col, i) => (
      <div class="col">
        <h3 class:list={["caps", "tab", { current: i === 0 }]}>{col.data.label}</h3>
        <ul class="frame">
          {col.data.items.map((it) => (
            <li>
              <div class="t">{it.url ? <a href={it.url}>{it.title}</a> : it.title}</div>
              {it.note && <div class="n">{it.note}</div>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
<style>
  .section { padding-block: 96px 104px; }
  h2 { margin-bottom: 48px; max-width: 760px; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 32px; }
  .col { display: flex; flex-direction: column; }
  .tab { align-self: flex-start; margin: 0 0 0 20px; letter-spacing: 0.14em; padding: 8px 18px 6px; border: 2px solid var(--ink); border-bottom: 0; background: var(--ground); color: var(--ink); }
  .tab.current { background: var(--ink); color: var(--ground); }
  ul { list-style: none; margin: 0; padding: 0; flex: 1 1 auto; }
  li { padding: 16px 18px; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 6px; }
  li:last-child { border-bottom: 0; }
  .t { font-size: 17px; font-weight: 600; line-height: 1.35; }
  .t a { color: inherit; text-decoration: none; }
  .t a:hover, .t a:focus-visible { text-decoration: underline; }
  .n { font-size: 14px; line-height: 1.5; color: var(--muted); }
  @media (max-width: 640px) { .section { padding-block: 64px 72px; } h2 { margin-bottom: 32px; } }
</style>
