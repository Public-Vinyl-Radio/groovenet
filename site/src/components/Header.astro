---
import Logo from "./Logo.astro";

interface Props { currentPath?: string; }
const { currentPath = "/" } = Astro.props;
// Section links are absolute, so they work from /about and /docs too.
const links = [
  { href: "/#features", label: "Features" },
  { href: "/#interfaces", label: "Interfaces" },
  { href: "/#appearance", label: "Appearance" },
  { href: "/#roadmap", label: "Roadmap" },
  { href: "/docs", label: "Docs" },
];
---
<header>
  <nav class="wrap" aria-label="Primary">
    <a class="home" href="/" aria-label="GrooveNet home"><Logo /></a>
    <ul class="links caps">
      {links.map((l) => <li><a href={l.href} aria-current={currentPath === l.href ? "page" : undefined}>{l.label}</a></li>)}
      <li><a class="gh" href="https://github.com/Public-Vinyl-Radio/groovenet">GitHub ↗</a></li>
    </ul>
  </nav>
</header>
<style>
  header { border-bottom: 2px solid var(--ink); }
  nav { padding-block: 18px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 20px; }
  .home { display: flex; align-items: center; }
  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; }
  .links a { text-decoration: none; }
  .links a[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .gh { display: inline-block; border: 2px solid var(--ink); padding: 10px 14px; box-shadow: 3px 3px 0 0 var(--shadow); background: var(--ground); }
  @media (max-width: 640px) {
    nav { padding-block: 14px; }
    .links { gap: 10px 16px; font-size: 11px; letter-spacing: 0.08em; }
    .gh { padding: 8px 10px; }
  }
</style>
