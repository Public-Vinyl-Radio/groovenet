---
// A holding page until #911 builds /docs with Starlight from the repo's docs/.
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import InstallSnippet from "../components/InstallSnippet.astro";

const repo = "https://github.com/Public-Vinyl-Radio/groovenet";
const cards = [
  { n: "02", title: "Configuration", body: "A Discogs account and PostgreSQL are the foundation. Apple Music, YouTube, OpenAI embeddings and AI metadata, and remote backup are optional integrations set through environment variables.", href: `${repo}#required-configuration`, link: "Required configuration ↗" },
  { n: "03", title: "Architecture", body: "A Next.js app over PostgreSQL with pgvector, and Redis queues. Audio analysis, playlist optimisation, downloads and fingerprint matching run as separate services.", href: `${repo}#development`, link: "Development ↗" },
  { n: "04", title: "CLI and MCP", body: "The groovenet CLI searches the collection, manages albums and playlists, runs the terminal player and prints JSON for scripts. The MCP server gives an MCP client such as Claude the same collection.", href: `${repo}/tree/main/mcp-server#readme`, link: "MCP server ↗" },
];
---
<BaseLayout title="GrooveNet documentation" description="Getting started with the self-hosted GrooveNet collection manager: install, configuration, architecture, CLI and MCP." currentPath="/docs">
  <section class="wrap hero">
    <SectionHead tag="Docs / Start here" />
    <h1 class="h2">Run GrooveNet.</h1>
    <p class="lede">GrooveNet is self-hosted: one Docker Compose stack on a machine you own. The repository's README is the full reference until these docs move here.</p>
  </section>
  <section class="wrap grid">
    <article class="frame install">
      <p class="eyebrow">01 · Install</p>
      <h2>Getting started</h2>
      <p>Needs Docker with Compose v2 and a Discogs account. Then open the app and use <strong>Sync from Discogs</strong> to import your collection.</p>
      <InstallSnippet />
      <a class="more caps" href={`${repo}#run-groovenet`}>Full install steps ↗</a>
    </article>
    {cards.map((c) => (
      <article class="frame">
        <p class="eyebrow">{c.n} · {c.title}</p>
        <h2>{c.title}</h2>
        <p>{c.body}</p>
        <a class="more caps" href={c.href}>{c.link}</a>
      </article>
    ))}
  </section>
  <section class="wrap links">
    <a class="btn" href={repo}>Source ↗</a>
    <a class="btn" href={`${repo}/releases`}>Releases ↗</a>
    <a class="btn" href={`${repo}/issues`}>Issues ↗</a>
  </section>
</BaseLayout>
<style>
  .hero { padding-block: 72px 48px; display: flex; flex-direction: column; gap: 24px; }
  .hero .lede { max-width: 640px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 32px; }
  article { padding: 28px; display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .install { grid-column: 1 / -1; }
  article h2 { font-size: 26px; font-weight: 600; letter-spacing: -0.02em; }
  article > p:not(.eyebrow) { color: var(--muted); line-height: 1.6; }
  .more { margin-top: auto; }
  .links { padding-block: 56px 96px; display: flex; flex-wrap: wrap; gap: 16px; }
  @media (max-width: 640px) { .hero { padding-block: 40px 32px; } article { padding: 20px; } .links { padding-block: 40px 64px; } }
</style>
