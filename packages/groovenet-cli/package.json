{
  "name": "@groovenet/cli",
  "version": "3.10.0",
  "description": "CLI for managing your Groovenet DJ collection",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "groovenet": "build/bin/groovenet.js"
  },
  "scripts": {
    "build": "tsc6",
    "dev": "tsc6 --watch",
    "lint": "eslint .",
    "start": "node build/bin/groovenet.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov",
    "test:watch": "vitest"
  },
  "files": [
    "build/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "groovenet",
    "dj",
    "music",
    "playlist",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Public-Vinyl-Radio/groovenet.git",
    "directory": "packages/groovenet-cli"
  },
  "homepage": "https://github.com/Public-Vinyl-Radio/groovenet/tree/main/packages/groovenet-cli#readme",
  "bugs": "https://github.com/Public-Vinyl-Radio/groovenet/issues",
  "dependencies": {
    "@groovenet/client": "^3.9.0",
    "@groovenet/contracts": "1.5.0",
    "@groovenet/player": "0.1.9",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6",
    "commander": "^15",
    "ink": "8.0.0",
    "react": "19.3.1",
    "sharp": "0.35.5",
    "string-width": "8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "ink-testing-library": "4.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0"
  }
}
