{
  "name": "@groovenet/cli",
  "version": "2.2.0",
  "description": "CLI for managing your Groovenet DJ collection",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "groovenet": "build/bin/groovenet.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/bin/groovenet.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov",
    "test:watch": "vitest"
  },
  "files": [
    "build/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "groovenet",
    "dj",
    "music",
    "playlist",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Public-Vinyl-Radio/groovenet.git",
    "directory": "packages/groovenet-cli"
  },
  "homepage": "https://github.com/Public-Vinyl-Radio/groovenet/tree/main/packages/groovenet-cli#readme",
  "bugs": "https://github.com/Public-Vinyl-Radio/groovenet/issues",
  "dependencies": {
    "@groovenet/client": "^2.2.0",
    "chalk": "^6",
    "cli-table3": "^0.6",
    "commander": "^15"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^7.0",
    "vitest": "^5.0.0"
  }
}
