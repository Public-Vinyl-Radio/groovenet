{
  "name": "@groovenet/client",
  "version": "1.0.3",
  "description": "Typed API client for the Groovenet DJ collection system",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "build/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "groovenet",
    "dj",
    "music",
    "playlist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Public-Vinyl-Radio/groovenet.git",
    "directory": "packages/groovenet-client"
  },
  "homepage": "https://github.com/Public-Vinyl-Radio/groovenet/tree/main/packages/groovenet-client#readme",
  "bugs": "https://github.com/Public-Vinyl-Radio/groovenet/issues",
  "dependencies": {
    "axios": "^1.20.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^7.0",
    "vitest": "^4.1.11"
  }
}
