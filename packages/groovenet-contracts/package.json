{
  "name": "@groovenet/contracts",
  "version": "1.7.0",
  "description": "Shared runtime schemas and inferred types for the Groovenet API",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./coercion": {
      "types": "./build/coercion.d.ts",
      "import": "./build/coercion.js"
    }
  },
  "scripts": {
    "build": "tsc6",
    "typecheck": "tsc6 --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src/home.ts --coverage.include=src/liveSets.ts --coverage.include=src/playlists.ts --coverage.include=src/tracks.ts --coverage.include=src/albums.ts --coverage.include=src/friends.ts --coverage.include=src/recordCare.ts --coverage.include=src/recordCareQueue.ts --coverage.include=src/recordCareSessions.ts --coverage.include=src/spins.ts --coverage.include=src/players.ts --coverage.include=src/genres.ts --coverage.include=src/settings.ts --coverage.include=src/backups.ts --coverage.include=src/jobs.ts --coverage.include=src/embeddings.ts --coverage.include=src/recommendations.ts --coverage.include=src/system.ts --coverage.include=src/coercion.ts --coverage.include=src/providers.ts --coverage.include=src/vinylIngest.ts --coverage.include=src/setDerivation.ts --coverage.include=src/artists.ts --coverage.reporter=lcov"
  },
  "files": [
    "build/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Public-Vinyl-Radio/groovenet.git",
    "directory": "packages/groovenet-contracts"
  }
}
