{
  "name": "@groovenet/contracts",
  "version": "1.2.0",
  "description": "Shared runtime schemas and inferred types for the Groovenet API",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src/liveSets.ts --coverage.include=src/playlists.ts --coverage.include=src/tracks.ts --coverage.include=src/albums.ts --coverage.include=src/friends.ts --coverage.include=src/recordCare.ts --coverage.include=src/spins.ts --coverage.reporter=lcov"
  },
  "files": [
    "build/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Public-Vinyl-Radio/groovenet.git",
    "directory": "packages/groovenet-contracts"
  }
}
