{
  "version": 2,
  "id": "x",
  "usePrior": true,
  "base": {
    "combine": "max",
    "signals": [
      "identity_similarity",
      "vibe_similarity"
    ]
  },
  "constraints": {
    "bpm_window": {
      "unit": "ratio",
      "max": 0.06,
      "half_double": true
    },
    "key_rule": {
      "metric": "wheel",
      "max": 1
    }
  },
  "weights": {
    "identity_similarity": 0.15,
    "vibe_similarity": 0.15,
    "key_relation": 0.3,
    "bpm_distance": 3,
    "genre_overlap": 0.9,
    "era": 0.15,
    "energy": 0.24
  }
}
