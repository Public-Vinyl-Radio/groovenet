# 1Password-backed .env.tpl (optional alternative to a plaintext .env).
# Export these in your shell before running just compose-*, just worktree-up,
# just deploy*, op run, or scripts/render-env.sh; .env is not loaded by op.
# Leave variables unset (not empty) to use the defaults shown below.
# export GROOVENET_OP_VAULT=Homelab
# export GROOVENET_OP_ITEM=groovenet
# export GROOVENET_OP_MQTT_ITEM=MQTT
# Both items live in GROOVENET_OP_VAULT. Create these exact field names:
# GROOVENET_OP_ITEM: POSTGRES_PASSWORD, DATABASE_URL, OPENAI_API_KEY, APPLE_MUSIC_TEAM_ID, APPLE_MUSIC_KEY_ID, APPLE_MUSIC_PRIVATE_KEY, DISCOGS_USER_TOKEN, DISCOGS_USERNAME, YOUTUBE_API_KEY, NEXT_PUBLIC_POSTHOG_KEY, SENTRY_DSN, RESTIC_REPOSITORY, RESTIC_PASSWORD, B2_ACCOUNT_ID, B2_ACCOUNT_KEY
# GROOVENET_OP_MQTT_ITEM: host, username, password
# NEXT_PUBLIC_POSTHOG_KEY supplies POSTHOG_KEY; host is a full MQTT broker URL.

# Pins the Compose project name so a bare `docker compose ...` run from this
# directory (no `-p` flag) can never default to the directory's basename
# instead. deploy-prod.sh already passes `-p dj-playlist` explicitly, which
# always wins over this — this exists for every other invocation, like
# `docker compose run --rm scripts ...`, which depends_on starts `db` under
# whatever project name is in effect. On 2026-10-11, running that kind of
# command from a directory named `groovenet` (no `-p`) started a second `db`
# container under project "groovenet" that mounted the exact same external
# volume as the real "dj-playlist"-named one, corrupting it (groovenet#538).
# Keep this the same value as deploy-prod.sh's PROJECT_NAME default.
COMPOSE_PROJECT_NAME=dj-playlist

# PostgreSQL credentials (used by both the db container and DATABASE_URL)
POSTGRES_USER=djplaylist
POSTGRES_PASSWORD=djplaylistpassword
POSTGRES_DB=djplaylist
DATABASE_URL=postgres://djplaylist:djplaylistpassword@localhost:5432/djplaylist
OPENAI_API_KEY=SAMPLEOPENAIKEY
# local_tags reconciliation (#372): the model, and its prices (USD per million
# tokens) used only to log what a run cost. Change the prices with the model.
OPENAI_GENRE_RECONCILIATION_MODEL=gpt-5-mini
GENRE_RECONCILIATION_INPUT_USD_PER_MTOK=0.25
GENRE_RECONCILIATION_OUTPUT_USD_PER_MTOK=2
# Similar genres (#377): fewer shared albums than this and a pair's
# co-occurrence isn't scored. How often the nightly backstop recompute runs,
# in minutes, independent of the mutations that trigger it immediately.
GENRE_SIMILARITY_MIN_SUPPORT_ALBUMS=3
GENRE_SIMILARITY_REFRESH_INTERVAL_MINUTES=1440
APPLE_MUSIC_TEAM_ID=sampleteamid
APPLE_MUSIC_KEY_ID=samplemusickey
# Paste the full contents of your .p8 key file here (newlines as \n)
APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
DISCOGS_USER_TOKEN=discogs_user_token
DISCOGS_USERNAME=discogs_user
DISCOGS_FOLDER_ID=0
YOUTUBE_API_KEY=youtube-api-key

# Developer tools (disabled by default). When enabled, the app exposes a
# Developer navigation item with links to Swagger and the configured Storybook.
# Images include a fresh static bundle at /storybook/index.html automatically.
# For hot-reload development, set STORYBOOK_URL=http://localhost:6006 and run
# `just storybook` in a separate terminal. Empty hides the Storybook card.
# STORYBOOK_STATIC_DIR is retired; use an external URL for an external bundle.
ENABLE_DEVELOPER_TOOLS=false
STORYBOOK_URL=/storybook/index.html

# Audio storage mounts (optional)
# Legacy/default behavior uses Docker named volume: music_data:/app/audio.
# App and worker must use the same backing store or downloads will not be
# visible to the web app in production.
# To use a host path (e.g. SMB/NFS mount), set both:
# APP_AUDIO_MOUNT=/Volumes/groovenet:/app/audio
# WORKER_AUDIO_MOUNT=/Volumes/groovenet:/app/audio
APP_AUDIO_MOUNT=
WORKER_AUDIO_MOUNT=
# Album covers in dev (docker-compose.dev.yml). Unset, both bind-mount
# $HOME/groovenet-covers, the folder `just sync-dev-assets` and
# `just sync-album-covers` fill from prod. Point them elsewhere to override.
# A restored prod DB references prod cover filenames, so the dev app must
# read the synced folder, not an empty named volume.
# APP_ALBUM_COVERS_SRC=/Users/you/groovenet-covers
# WORKER_ALBUM_COVERS_SRC=/Users/you/groovenet-covers
# `just compose-dev` runs `just sync-dev-assets` only when this is set
# (user@host of the prod box; covers volume path via COVERS_REMOTE_PATH).
# ASSET_SYNC_HOST=deploy@your-server.example.com
# Where whole set recordings live for tracklist derivation (#282), mounted
# read-only into fingerprint-set-worker. Defaults to the set_recordings named
# volume; a host folder of recordings works too:
# SET_RECORDINGS_MOUNT=/Volumes/groovenet/sets:/app/set-recordings
# The app mounts the same store read-write: it is where CLI uploads land.
SET_RECORDINGS_MOUNT=
# Largest set recording the app will accept, in bytes. 2 GiB.
SET_RECORDING_MAX_BYTES=2147483648
# A derivation still queued or processing after this long is presumed lost and
# replaced by the next request for it. A 3-hour set takes under a minute.
SET_DERIVATION_STALL_MINUTES=30

# Days since its last cleaning before a record copy counts as overdue (#262),
# when a care query does not pass overdue_days. Read at runtime.
RECORD_CLEANING_OVERDUE_DAYS=365

# Product analytics (optional). `none` (the default) sends nothing: no SDK is
# initialised and the /ingest proxy answers 404. Set to `posthog` to enable.
# Read at runtime, so a published image can be switched without a rebuild.
ANALYTICS_PROVIDER=none
POSTHOG_KEY=your-posthog-project-api-key
POSTHOG_HOST=https://us.i.posthog.com

# Exception reporting for non-web services. Leave unset to disable.
# Use the Sentry project DSN for the backend services.
SENTRY_DSN=
# Keep this in sync with the root package.json version when releasing.
SENTRY_RELEASE=0.3.2

# Remote backups (restic + Backblaze B2)
# Repository format for B2: b2:<bucket-name>:<path>
# Example: b2:groovenet-backups:prod/my-collection-search
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Uptime Kuma backup-health alert threshold. The current six-hour schedule
# should stay below the default 12 hours; use 30 for a daily schedule.
BACKUP_HEALTH_MAX_AGE_HOURS=12
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Job retention / queue health (seconds)
# Active/queued jobs keep a longer TTL for recovery visibility.
JOB_TTL_ACTIVE_SECONDS=604800
# Completed/failed jobs expire faster to avoid unbounded Redis growth.
JOB_TTL_TERMINAL_SECONDS=259200

# Embedding queue (#450). Each tick drains edits/uploads first, then Discogs
# and album sync, then backfills/sweeps. Compatible texts are sent in one
# provider request per kind/model/dimensions; failed jobs retry with backoff.
# A slow tick never overlaps the next. At 100 jobs per 10 seconds the theoretical
# ceiling is 600/minute; actual throughput depends on DB and provider limits.
# Sweeps run only when all queues and retries are empty. Read at startup.
EMBEDDING_QUEUE_INTERVAL_SECONDS=10
EMBEDDING_QUEUE_BATCH_SIZE=100
EMBEDDING_SWEEP_INTERVAL_MINUTES=30

# Vinyl audio ingest (#281). The app writes listener chunks here and
# fingerprint-service reads them from the same path.
AUDIO_INGEST_DIR=/app/audio-ingest
# Retention for that volume (#269). A chunk is worthless once fingerprinted —
# the audio_ingests row keeps everything worth keeping — so the app sweeps it.
# Oldest a file may get before it is swept whatever its record says. This is the
# backstop for a worker that died mid-job and left its record in `processing`;
# nothing legitimately holds a 15-second chunk that long.
# Limits on one uploaded chunk (#275). A listener device posts ~15s windows;
# anything far outside that is a misconfigured device, not a play.
AUDIO_INGEST_MAX_UPLOAD_BYTES=20971520
AUDIO_INGEST_MIN_DURATION_SECONDS=3
AUDIO_INGEST_MAX_DURATION_SECONDS=60
# How long a chunk may sit un-claimed or in-flight before it is written off
# as failed so its file can be released (#276). A 15s window that has not come
# back in ten minutes is not coming back.
AUDIO_INGEST_STALL_MINUTES=10
AUDIO_INGEST_REAP_INTERVAL_MINUTES=5
AUDIO_INGEST_MAX_AGE_HOURS=24
# Total bytes the ingest volume may hold. Over budget, the oldest sweepable
# files go first. 2 GiB.
AUDIO_INGEST_MAX_BYTES=2147483648
# How long a file with no audio_ingests row must sit before it counts as an
# orphan. The route writes the file before inserting the row, so for a moment
# every legitimate upload looks orphaned — this is what stops the sweeper
# racing the writer.
AUDIO_INGEST_ORPHAN_GRACE_MINUTES=60
# Minutes between sweeps. The scheduler ticks every minute regardless.
AUDIO_INGEST_SWEEP_INTERVAL_MINUTES=15
# Decode rate for matching. 22050 or 44100 only — Chromaprint resamples
# internally, so the higher rate only costs decode time.
FINGERPRINT_SAMPLE_RATE=22050
# `chromaprint` is the real matcher; `stub` matches nothing and is only useful
# for exercising the pipeline without an index.
FINGERPRINT_MATCHER=chromaprint
# Bit error rate above which a candidate is discarded. Measured on the #271
# corpus: true matches ran 0.02-0.25, the lowest false candidate sat at 0.298,
# and this produced zero false positives over 788 held-out queries. Raising it
# buys recall with false plays -- #279 counts one detection as a play.
FINGERPRINT_MAX_BER=0.25
# Below this fraction of distinct fingerprint values, a query window is
# refused before it is ever searched (#306). Silence measures 0.01-0.03 and
# real music 0.98-1.00 -- two silences fingerprint identically, a true bit
# error rate of 0.0 that no FINGERPRINT_MAX_BER can substitute for. 0 restores
# the old behaviour.
FINGERPRINT_MIN_VARIETY=0.20
# Windows quieter than this (dBFS) are not matched — an idle analog chain's
# hiss passes the variety check above and can resemble a quiet stretch of some
# reference track. Off when empty. Set it from real values: every detection
# records its level (the Level column on /vinyl, `groovenet vinyl detections`);
# pick a floor between the loudest silence and the quietest music.
FINGERPRINT_MIN_LEVEL_DBFS=
# The recipe stored fingerprints are written under. NOT libchromaprint's
# version -- 1.5.1 and 1.6.1 emit identical bytes, and keying on the library
# would make a base-image bump invalidate the whole index. Bump this only when
# the fingerprint recipe itself changes.
FINGERPRINT_VERSION=1
# How often the in-memory reference index is rebuilt from the app. Library
# indexing (#277) runs on its own schedule; without this the service would
# never match anything indexed since it started.
FINGERPRINT_INDEX_REFRESH_SECONDS=900
# How soon a failed index load is retried -- e.g. when the service starts
# before the app is reachable. Without it the service matches nothing until
# the next full refresh.
FINGERPRINT_INDEX_RETRY_SECONDS=30
# How often the app queues newly-arrived audio that has no fingerprint yet
# (#303). This is the backstop only — audio gained through PATCH /api/tracks
# is queued immediately; this catches everything else and anything the
# immediate trigger missed. The scheduler still ticks every minute.
FINGERPRINT_BACKFILL_INTERVAL_MINUTES=30
# How often every fingerprinted track is re-checked for replaced audio (#303).
# fingerprint-service stats each file and hashes only those whose size or mtime
# moved, so this is cheap — except the first pass after deploying #303, which
# hashes every indexed file once to record their stats.
FINGERPRINT_VERIFY_INTERVAL_MINUTES=60
# Raw matcher output is diagnostic; set 0 to make repository pruning a no-op.
PLAY_DETECTIONS_RETENTION_DAYS=30
# Confidence a detection needs to open or extend an automatic spin (#279).
PLAY_CONFIDENCE_FLOOR=0.75
# How long a gap between detections of the same track is still one play,
# rather than the record being put on again later (#279).
PLAY_AGGREGATION_GAP_SECONDS=45
# Windows a run needs before it becomes a spin. Every false spin seen so far
# was a single window at a track boundary; every real play ran four or more.
# A run whose position in its track does not advance with the clock (noise
# matching the same spot over and over) never becomes a spin, however long.
PLAY_MIN_WINDOWS=2
# How often the app aggregates recent detections into spin sessions (#304).
# This is the backstop only — a confident detection triggers aggregation for
# its source immediately; this catches anything that trigger missed. The
# scheduler still ticks every minute.
PLAY_AGGREGATION_INTERVAL_MINUTES=5
# How far back an aggregation pass looks, from either trigger. Wide enough to
# hold one play's full run of windows without scanning a source's whole
# history every time.
PLAY_AGGREGATION_LOOKBACK_MINUTES=60

# Live now-playing tracking over MQTT (#465): what shairport-sync's
# publish_parsed/publish_cover does for AirPlay, but for whatever the listener
# hears off the mixer's rec output. Off entirely unless MQTT_URL is set; a
# broker that is down or unreachable never slows or fails ingest.
# e.g. mqtt://homeassistant.local:1883
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# Topics publish under <prefix>/<source_id>/... , e.g.
# groovenet/now_playing/living-room-vinyl/state.
MQTT_TOPIC_PREFIX=groovenet/now_playing
# How long a display keeps showing the last track with state=stopped before
# the retained topics clear to empty (state=idle). The needle-lifted ->
# stopped transition itself uses PLAY_AGGREGATION_GAP_SECONDS above, so the
# two states' timings stay in step with the spin-logging pipeline.
NOW_PLAYING_CLEAR_SECONDS=60
# Publish Home Assistant MQTT discovery (homeassistant/sensor/.../config) so a
# "Groovenet now playing" sensor appears with no YAML. Set to false if you'd
# rather wire the entity by hand.
MQTT_HA_DISCOVERY=true

# docker-compose.prod.yml only: each production volume is external, and its
# name comes from one of these — required, with no shared default. Pick a
# name unique to this host/stack (e.g. prefixed with its directory or
# hostname). Two prod deploys on the same host must never resolve to the same
# literal name here, even under a different COMPOSE_PROJECT_NAME/-p: that
# silently double-mounts one Postgres data directory from two containers and
# corrupts it (what happened on 2026-10-11 — both "dj-playlist" and
# "groovenet" project names pointed at a volume literally named
# "teststack_db_data_v2"). Leaving one unset makes `docker compose` refuse to
# start rather than guess.
PROD_DB_DATA_VOLUME=
PROD_MUSIC_DATA_VOLUME=
PROD_DB_DUMPS_VOLUME=
PROD_DISCOGS_EXPORTS_VOLUME=
PROD_REDIS_DATA_VOLUME=
PROD_COOKIE_DATA_VOLUME=
PROD_ALBUM_COVERS_VOLUME=
PROD_ESSENTIA_DATA_VOLUME=

# --- Browser tests (just player-e2e) ---------------------------------------
# Not read by docker compose. Overrides the app URL the Playwright player
# suite drives; by default `just player-e2e` uses this worktree's APP_PORT.
# E2E_BASE_URL=http://127.0.0.1:3000

# Optional persistent server playback: docker-compose.players.yml, profile players.
# .env.players.tpl reads PLAYER_API_KEY and both PLAYER_ENGINE_*_PASSWORD fields
# from the existing GROOVENET_OP_VAULT/GROOVENET_OP_ITEM. Render it with op run
# and my-collection-search/scripts/render-player-env.mjs; never commit resolved values.
# All player endpoints require this shared household/admin bearer key (>=32 chars).
PLAYER_API_KEY=
# Optional browser authorization. Put these settings in a private
# .env.player-web (0600); the players overlay loads it only into the app.
# `just player-web-setup` renders/uploads these from .env.player-web.tpl via op.
# Use independent random values; neither secret may equal PLAYER_API_KEY.
# Web passphrase: >=24 characters; signing secret: >=32 characters.
PLAYER_WEB_PASSPHRASE=
PLAYER_WEB_SESSION_SECRET=
# Browser session length in days (default 365; 1-3650).
PLAYER_WEB_SESSION_DAYS=365
# Exact public HTTPS origin, no trailing slash or path.
PLAYER_WEB_ORIGIN=
PLAYER_WORKER_URL=http://player-worker:13700
# Two distinct engine admin passwords, hex/base64url only (e.g. openssl rand -hex 24).
PLAYER_ENGINE_A_PASSWORD=
PLAYER_ENGINE_B_PASSWORD=
PLAYER_LAN_INTERFACE=enp170s0
# Read-only mount source: named volume or absolute path, as seen by Docker.
PLAYER_AUDIO_MOUNT=music_data
# Must match the two engine passwords above. Engine credentials stay server-side.
# PLAYER_ENGINES_JSON={"primary":{"apiUrl":"http://host.docker.internal:13689/api","password":"A_PASSWORD","libraryRoot":"/srv/media"},"secondary":{"apiUrl":"http://host.docker.internal:13690/api","password":"B_PASSWORD","libraryRoot":"/srv/media"}}
PLAYER_ENGINES_JSON=
# Optional read-only Home Assistant observer. Unconfigured/unavailable is unknown.
PLAYER_HA_URL=
PLAYER_HA_TOKEN=
PLAYER_HA_ENTITIES_JSON={}
# Exact HA sender attribute matches, keyed by dedicated engine ID (never a shared IP).
PLAYER_HA_SENDERS_JSON={}
# Non-Compose worker override; Compose uses 13700 internally.
PLAYER_WORKER_PORT=13700

# Optional shell environment overrides for `just worktree-seed-prod`.
# Export these in the invoking shell; the seed script does not load this file.
# PROD_SEED_HOST=saegey@your-production-host
# PROD_SEED_DB_CONTAINER=groovenet_db
# PROD_SEED_APP_CONTAINER=groovenet_webapp
# Optional host directory override; uses sudo instead of the app container.
# PROD_SEED_COVERS_PATH=/absolute/path/to/album-covers
